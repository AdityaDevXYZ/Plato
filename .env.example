# ==============================================================================
# PLATO: Commercial Satellite Constellation Mission Control Platform
# Environment Configuration Template
# ==============================================================================

# Execution Environment: 'development' | 'production' | 'staging'
RUN_MODE=production

# Server Host & Port
PLATO__SERVER__HOST=0.0.0.0
PLATO__SERVER__PORT=8080

# PostgreSQL / TimescaleDB Connection
# Format: postgres://<user>:<password>@<host>:<port>/<database>
PLATO__DB__URL=postgres://plato:plato_secret_dev@localhost:5432/plato
DATABASE_URL=postgres://plato:plato_secret_dev@localhost:5432/plato
POSTGRES_USER=plato
POSTGRES_PASSWORD=plato_secret_dev
POSTGRES_DB=plato
POSTGRES_PORT=5432

# Application & Security Metadata
PLATO__APP__NAME="PLATO Mission Control Platform"
PLATO__APP__VERSION="1.0.0"
PLATO__APP__JWT_SECRET=production_enterprise_jwt_secret_change_me_0123456789abcdef

# Mission Control Web Console (Next.js 14)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
PORT=3000

# Telemetry & Observability
RUST_LOG=info,api=debug,worker=debug,storage=info
